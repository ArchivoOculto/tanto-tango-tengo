[gd_resource type="Resource" script_class="SoundEvent" format=3]

[ext_resource type="Script" path="res://Scripts/audio/sound_event.gd" id="1_event"]

[resource]
script = ExtResource("1_event")
id = &"farolito_off"
volume_db = -4.0
volume_variation_db = 1.5
pitch_variation = 0.05
spatial = true
max_distance = 15.0
max_voices = 2
description = "Clic/apagón corto al quedar apagada.\nArchivos: farolito_off_01.wav, farolito_off_02.wav\nSe dispara desde: Scripts/props/farolito.gd → toggled(false) / _apply_current_state()"
