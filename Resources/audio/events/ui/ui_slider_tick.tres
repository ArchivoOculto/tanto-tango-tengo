[gd_resource type="Resource" script_class="SoundEvent" format=3]

[ext_resource type="Script" path="res://Scripts/audio/sound_event.gd" id="1_event"]

[resource]
script = ExtResource("1_event")
id = &"ui_slider_tick"
bus = "UI"
volume_db = -10.0
pitch_variation = 0.05
max_distance = 10.0
max_voices = 1
cooldown = 0.05
description = "Ajustar un slider de volumen (un 'tic' por paso).\nArchivos: ui_slider_tick_01.wav\nSe dispara desde: Scripts/ui/menu_base.gd → value_changed de los sliders"
