[gd_resource type="Resource" script_class="SoundEvent" format=3]

[ext_resource type="Script" path="res://Scripts/audio/sound_event.gd" id="1_event"]

[resource]
script = ExtResource("1_event")
id = &"ui_inventory_open"
bus = "UI"
volume_db = -5.0
pitch_variation = 0.02
max_distance = 10.0
max_voices = 1
description = "Abrir el inventario.\nArchivos: ui_inventory_open_01.wav\nSe dispara desde: Scripts/inventory/inventory_menu.gd → open() / open_picker()"
