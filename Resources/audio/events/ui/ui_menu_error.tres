[gd_resource type="Resource" script_class="SoundEvent" format=3]

[ext_resource type="Script" path="res://Scripts/audio/sound_event.gd" id="1_event"]

[resource]
script = ExtResource("1_event")
id = &"ui_menu_error"
bus = "UI"
volume_db = -6.0
max_distance = 10.0
max_voices = 1
cooldown = 0.2
description = "Acción no disponible (no hay cassette, menú bloqueado).\nArchivos: ui_menu_error_01.wav\nSe dispara desde: Scripts/interaction/interactable_object.gd → _trigger_action() cuando no hay candidatos"
