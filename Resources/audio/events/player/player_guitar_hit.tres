[gd_resource type="Resource" script_class="SoundEvent" format=3]

[ext_resource type="Script" path="res://Scripts/audio/sound_event.gd" id="1_event"]

[resource]
script = ExtResource("1_event")
id = &"player_guitar_hit"
volume_db = -2.0
volume_variation_db = 2.0
pitch_variation = 0.06
spatial = true
max_voices = 3
cooldown = 0.05
description = "Impacto del guitarrazo contra algo golpeable (enemigo, farola, radio, prop).\nArchivos: player_guitar_hit_01.wav, player_guitar_hit_02.wav, player_guitar_hit_03.wav\nSe dispara desde: Scripts/player/weapon_hitbox.gd → _process_hit() cuando el golpe conecta"
