[gd_resource type="Resource" script_class="SoundEvent" format=3]

[ext_resource type="Script" path="res://Scripts/audio/sound_event.gd" id="1_event"]

[resource]
script = ExtResource("1_event")
id = &"player_rifle_shoot"
volume_db = -2.0
volume_variation_db = 1.5
pitch_variation = 0.05
spatial = true
max_distance = 25.0
max_voices = 3
description = "Disparo del fusil.\nArchivos: player_rifle_shoot_01.wav, player_rifle_shoot_02.wav, player_rifle_shoot_03.wav\nSe dispara desde: Scripts/player/rifle_controller.gd → al disparar (GameplayInput.just_pressed rifle_shoot)"
