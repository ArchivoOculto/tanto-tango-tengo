[gd_resource type="Resource" script_class="SoundEvent" format=3]

[ext_resource type="Script" path="res://Scripts/audio/sound_event.gd" id="1_event"]

[resource]
script = ExtResource("1_event")
id = &"player_damage"
volume_db = -2.0
volume_variation_db = 1.5
pitch_variation = 0.05
max_distance = 10.0
max_voices = 2
cooldown = 0.1
description = "El jugador recibe daño (quejido/golpe seco). Plano, para que se sienta cerca.\nArchivos: player_damage_01.wav, player_damage_02.wav, player_damage_03.wav\nSe dispara desde: Scripts/player/player.gd → take_damage()"
