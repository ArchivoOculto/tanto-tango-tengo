[gd_resource type="Resource" script_class="SoundEvent" format=3]

[ext_resource type="Script" path="res://Scripts/audio/sound_event.gd" id="1_event"]

[resource]
script = ExtResource("1_event")
id = &"enemy_spawn"
volume_db = -3.0
volume_variation_db = 1.5
pitch_variation = 0.06
spatial = true
max_distance = 15.0
max_voices = 3
cooldown = 0.2
description = "Un enemigo aparece/reaparece en el nivel.\nArchivos: enemy_spawn_01.wav, enemy_spawn_02.wav\nSe dispara desde: Scripts/level/level00_manager.gd → _spawn_enemy_at()"
