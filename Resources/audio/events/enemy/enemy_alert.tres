[gd_resource type="Resource" script_class="SoundEvent" format=3]

[ext_resource type="Script" path="res://Scripts/audio/sound_event.gd" id="1_event"]

[resource]
script = ExtResource("1_event")
id = &"enemy_alert"
volume_db = -4.0
volume_variation_db = 2.0
pitch_variation = 0.08
spatial = true
max_distance = 14.0
max_voices = 3
cooldown = 0.5
description = "El enemigo detecta al jugador y empieza a perseguirlo.\nArchivos: enemy_alert_01.wav, enemy_alert_02.wav\nSe dispara desde: Scripts/enemies/enemy.gd → al pasar al estado CHASE (_process_state_machine)"
