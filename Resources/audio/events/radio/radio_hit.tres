[gd_resource type="Resource" script_class="SoundEvent" format=3]

[ext_resource type="Script" path="res://Scripts/audio/sound_event.gd" id="1_event"]

[resource]
script = ExtResource("1_event")
id = &"radio_hit"
volume_db = -2.0
volume_variation_db = 2.0
pitch_variation = 0.06
spatial = true
max_distance = 15.0
max_voices = 2
cooldown = 0.05
description = "La radio recibe un golpe (vibración metálica/plástica).\nArchivos: radio_hit_01.wav, radio_hit_02.wav, radio_hit_03.wav\nSe dispara desde: Scripts/props/radio.gd → take_hit()"
