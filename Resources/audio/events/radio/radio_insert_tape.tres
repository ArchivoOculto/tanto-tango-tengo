[gd_resource type="Resource" script_class="SoundEvent" format=3]

[ext_resource type="Script" path="res://Scripts/audio/sound_event.gd" id="1_event"]

[resource]
script = ExtResource("1_event")
id = &"radio_insert_tape"
volume_db = -2.0
volume_variation_db = 1.5
pitch_variation = 0.05
spatial = true
max_distance = 15.0
max_voices = 1
description = "Meter un cassette en la radio.\nArchivos: radio_insert_tape_01.wav, radio_insert_tape_02.wav\nSe dispara desde: Scripts/props/radio.gd → _on_action_triggered() (acción 'reproducir cinta')"
