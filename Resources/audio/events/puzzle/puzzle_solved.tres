[gd_resource type="Resource" script_class="SoundEvent" format=3]

[ext_resource type="Script" path="res://Scripts/audio/sound_event.gd" id="1_event"]

[resource]
script = ExtResource("1_event")
id = &"puzzle_solved"
volume_db = -3.0
max_distance = 10.0
max_voices = 1
description = "Puzzle de farolas resuelto (jingle corto de acierto).\nArchivos: puzzle_solved_01.wav\nSe dispara desde: Scripts/puzzle/puzzle_manager.gd → _on_puzzle_solved()"
