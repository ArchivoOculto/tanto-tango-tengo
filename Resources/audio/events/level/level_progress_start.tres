[gd_resource type="Resource" script_class="SoundEvent" format=3]

[ext_resource type="Script" path="res://Scripts/audio/sound_event.gd" id="1_event"]

[resource]
script = ExtResource("1_event")
id = &"level_progress_start"
volume_db = -4.0
max_distance = 10.0
max_voices = 1
description = "Aparece la barra de carga: se puso el cassette correcto.\nArchivos: level_progress_start_01.wav\nSe dispara desde: Scripts/level/level00_manager.gd → _set_correct_playing(true)"
