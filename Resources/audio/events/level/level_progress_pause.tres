[gd_resource type="Resource" script_class="SoundEvent" format=3]

[ext_resource type="Script" path="res://Scripts/audio/sound_event.gd" id="1_event"]

[resource]
script = ExtResource("1_event")
id = &"level_progress_pause"
volume_db = -5.0
max_distance = 10.0
max_voices = 1
description = "La música correcta se corta (cinta expulsada/terminada) y la barra se frena.\nArchivos: level_progress_pause_01.wav\nSe dispara desde: Scripts/level/level00_manager.gd → _set_correct_playing(false)"
