[gd_resource type="Resource" script_class="SoundEvent" format=3]

[ext_resource type="Script" path="res://Scripts/audio/sound_event.gd" id="1_event"]

[resource]
script = ExtResource("1_event")
id = &"level_ending_message"
volume_db = -8.0
max_distance = 10.0
max_voices = 1
description = "Aparece el texto final sobre el negro (nota suave).\nArchivos: level_ending_message_01.wav\nSe dispara desde: Scripts/level/level00_manager.gd → _begin_ending() (al mostrar el mensaje)"
