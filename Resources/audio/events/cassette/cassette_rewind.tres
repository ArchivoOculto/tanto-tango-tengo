[gd_resource type="Resource" script_class="SoundEvent" format=3]

[ext_resource type="Script" path="res://Scripts/audio/sound_event.gd" id="1_event"]

[resource]
script = ExtResource("1_event")
id = &"cassette_rewind"
volume_db = -4.0
max_distance = 10.0
max_voices = 1
description = "Rebobinar el cassette desde el inventario (~1 s).\nArchivos: cassette_rewind_01.wav\nSe dispara desde: Scripts/inventory/cassette_item.gd → do_inventory_action() ('rewind')"
